# Copy to .env.local and fill in. Never commit .env.local.

# Public address of the app, including the scheme.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. For local development run `pnpm db:start` at the repository root and copy
# the API URL, the publishable key and the secret key it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Full database access. Server only.
SUPABASE_SECRET_KEY=

# Signs the unsubscribe links in marketing email. Server only, at least 32 characters (for
# example the output of `openssl rand -base64 48`). Required on a deploy, which refuses to start
# without it. Never change it once emails have gone out: every link already sent would stop
# working, and the Spam Act wants them to work for 30 days. Locally leave it unset: the links are
# signed from SUPABASE_SECRET_KEY.
# UNSUBSCRIBE_SECRET=

# Cloudflare Turnstile site key. This is Cloudflare's published test key, which always
# passes. Use it locally and in CI only: a deploy refuses it at start-up.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# The Turnstile secret, for the bot check the app makes itself on share pages. Server only.
# Locally leave it unset: Cloudflare's always-pass test secret stands in. On a deploy set the
# real secret (the same one Supabase Auth uses); until it is set, share pages refuse answers.
# TURNSTILE_SECRET_KEY=

# The header in which the host writes the caller's address. It is the only header the
# rate limit trusts. On Vercel leave it unset: the default is x-vercel-forwarded-for.
# Locally nothing writes that header, so tests send x-real-ip themselves.
CLIENT_ADDRESS_HEADER=x-real-ip

# This address may register while sign-up is closed. Optional.
OWNER_EMAIL=

# Show the "Continue with Google" button. Needs Google enabled in Supabase. Optional.
GOOGLE_SIGN_IN=false

# Show the "Show in 3D" button under the drawing. A trial (decision 0014), hidden for the
# beta (decision 0027). Shown only when this is exactly true. Optional.
SHOW_3D=false

# AI spend allowances for each calendar month (UTC), in microdollars (millionths of a US
# dollar). They start again at midnight UTC on the 1st. Optional: the defaults are
# provisional. A limit stored for one user or brand in the usage_limits table (set with
# usage_set_limit) replaces these.
# USAGE_USER_MONTHLY_AI=7500000
# USAGE_BRAND_MONTHLY_AI=30000000
# USAGE_USER_MONTHLY_PHOTOREAL=15000000
# USAGE_BRAND_MONTHLY_PHOTOREAL=60000000
# Safety ceiling across every user for the day. A warning is logged at half and at full.
# USAGE_GLOBAL_DAILY_CEILING=25000000

# AI provider keys (owner action A3). Optional: without the key for INTENT_MODEL the
# assistant is shown as not available, and only short requests the rules can read work.
# Paid tiers only. Set a monthly spend limit in each provider's console.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# The model tried first, and the stronger one tried once before a question is asked.
# Chosen by the live evaluation (docs/evals/README.md). Ids are listed in lib/providers/catalog.ts.
# INTENT_MODEL=claude-haiku-4-5
# INTENT_RETRY_MODEL=claude-sonnet-5-5
# Photoreal images (plan step 14). Optional: without it the feature is shown as
# unavailable. Use a key from a Google project with billing on; on the free tier Google
# may train on what is sent. See docs/data-processing.md.
GEMINI_API_KEY=

# Browser tests only (playwright.config.ts sets it): "on" answers the assistant with a
# stand-in that never reaches the network. A deploy refuses to start with it on.
# AI_PROVIDER_STUB=off

# Error monitoring (plan step 26). Optional: without it errors go to the server log only.
# The chosen provider is Sentry in its EU data region (owner decision 2026-09-30): create the
# project in an EU-region Sentry organisation, whose DSN names an ingest host under
# de.sentry.io. A DSN outside the EU region is used but warned about at start. An https
# webhook that takes JSON also works. Keys, tokens and email addresses are scrubbed before
# anything is sent. See lib/monitoring.
# MONITORING_DSN=https://<public key>@o<organisation id>.ingest.de.sentry.io/<project id>
