{
  "name": "knitwright-platform",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test",
    "test:cov": "pnpm --filter web test:cov",
    "e2e": "pnpm --filter web e2e",
    "db:start": "supabase start -x studio,postgres-meta,imgproxy,logflare,vector,realtime,edge-runtime,supavisor && node scripts/write-local-env.mjs",
    "db:start:studio": "supabase start && node scripts/write-local-env.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:env": "node scripts/write-local-env.mjs"
  },
  "devDependencies": {
    "supabase": "2.122.0"
  }
}
