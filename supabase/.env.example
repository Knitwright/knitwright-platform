# Copy to supabase/.env for local development. Never commit supabase/.env.

# Cloudflare's published test secret. It accepts any token, so it is for local use
# and CI only. The hosted project uses the owner's real secret.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Only read when sign-in with Google is enabled in config.toml.
GOOGLE_CLIENT_SECRET=
